javascript:(function(){let url=window.location.href;if(!url.includes('instagram.com')){alert('⚠%EF%B8%8F Please use this bookmarklet on Instagram!');return}navigator.clipboard.writeText(url).then(()=>{let modal=document.createElement('div');modal.style.cssText='position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);z-index:999999;display:flex;align-items:center;justify-content:center;font-family:Arial,sans-serif';let box=document.createElement('div');box.style.cssText='background:white;border-radius:15px;padding:30px;max-width:500px;width:90%;box-shadow:0 10px 40px rgba(0,0,0,0.3)';box.innerHTML=`<h2 style='margin:0 0 10px 0;color:#333;text-align:center'>Choose a Downloader</h2><p style='color:#28a745;text-align:center;margin-bottom:5px;font-weight:bold'>✓ URL copied to clipboard!</p><p style='color:#666;text-align:center;margin-bottom:20px;font-size:12px'>The URL will be automatically pasted</p><div style='display:flex;flex-direction:column;gap:10px'><button data-url='https://snapinsta.ai' style='padding:15px;background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;font-weight:bold;transition:transform 0.2s'>📱 SnapInsta</button><button data-url='https://igram.world/en' style='padding:15px;background:linear-gradient(135deg,#f093fb,#f5576c);color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;font-weight:bold;transition:transform 0.2s'>🎬 iGram</button><button data-url='https://inflact.com/downloader/instagram/video' style='padding:15px;background:linear-gradient(135deg,#4facfe,#00f2fe);color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;font-weight:bold;transition:transform 0.2s'>⚡ Inflact</button><button data-url='https://en.savefrom.net' style='padding:15px;background:linear-gradient(135deg,#43e97b,#38f9d7);color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;font-weight:bold;transition:transform 0.2s'>💾 SaveFrom</button><button data-url='https://fastdl.app' style='padding:15px;background:linear-gradient(135deg,#fa709a,#fee140);color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;font-weight:bold;transition:transform 0.2s'>⚡ FastDL</button></div><button onclick='this.parentElement.parentElement.remove()' style='margin-top:20px;padding:10px;background:#f44336;color:white;border:none;border-radius:8px;cursor:pointer;width:100%;font-weight:bold'>✖ Close</button>%60;modal.appendChild(box);document.body.appendChild(modal);let buttons=box.querySelectorAll('button[data-url]');buttons.forEach(btn=>{btn.onmouseover=()=>btn.style.transform='translateY(-2px)';btn.onmouseout=()=>btn.style.transform='translateY(0)';btn.onclick=()=>{window.open(btn.getAttribute('data-url'),'_blank');modal.remove()}})}).catch(()=>{alert('Failed to copy URL. Please copy it manually: '+url)})})();
